{
  "name": "cortico-provider-deepseek",
  "version": "0.3.0",
  "type": "module",
  "description": "Cortico 的 DeepSeek Responses API 模型供应商扩展，支持峰谷计价与关闭、低、高、最大四档思考。",
  "license": "MIT",
  "author": "DTMosken",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DTMosken/cortico-provider-deepseek.git"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./index.ts",
  "keywords": [
    "cortico-provider"
  ],
  "files": [
    "index.ts",
    "pricing.ts",
    "web-tools.ts",
    "webui",
    "dist",
    "scripts/migrate-rmb-currency.mjs",
    "README.md",
    "LICENSE",
    "describe.json",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "build:webui": "esbuild webui/client.ts --bundle --format=esm --outfile=dist/webui.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate:currency": "node scripts/migrate-rmb-currency.mjs"
  },
  "cortico": {
    "kind": "provider",
    "api": 6,
    "webUiClient": "dist/webui.js",
    "tags": [],
    "describe": "describe.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "0.2.13",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.5.0"
}
